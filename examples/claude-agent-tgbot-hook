#!/usr/bin/env bash
# Обертка для AI_AGENT_ALERT_CMD.
#
# Зачем она нужна. Переменная обязана содержать путь к ОДНОМУ исполняемому
# файлу: и reconciler (`"$AI_AGENT_ALERT_CMD" "$1" "$2" "${3:-}"`), и
# runner (`subprocess.run([cmd, ...])`) подставляют ее как argv[0] целиком.
# Значение вида "ai-agent-tgbot send" не сработает - оно будет искаться
# как имя файла с пробелом.
#
# "$@" форвардит ВСЕ аргументы, включая четвертый (json-detail карточки
# вопроса, V2.5 §3), а exec сохраняет код возврата - на нем держится правило
# "ступень лесенки продвигается только после успешной доставки" (V2.6 §4).
#
# Установка:
#   install -m 0755 examples/ai-agent-tgbot-hook ~/.local/bin/
#   echo "AI_AGENT_ALERT_CMD=$HOME/.local/bin/ai-agent-tgbot-hook" \
#     >> ~/.config/ai-control/env
#
# ВАЖНО: путь в EnvironmentFile - только абсолютный. systemd не раскрывает
# ни "~", ни переменные окружения в значениях EnvironmentFile: буквальная
# строка "~/.local/..." дойдет до execve как есть и упадет с ENOENT, а все
# пуши тихо превратятся в недоставку (аудит V2.6, major).
exec "$HOME/.local/bin/ai-agent-tgbot" send "$@"
