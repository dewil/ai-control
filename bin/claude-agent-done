#!/usr/bin/env python3
"""claude-agent-done: заявка агента о готовности (V2.7a §3).

usage: claude-agent-done [--summary "..."]

Каталог агента и ключ конверта - из env, которые runner уже прокидывает в
прогон (та же дисциплина, что claude-agent-ask): CLAUDE_AGENT_DIR,
CLAUDE_AGENT_EVENT_KEY. Привязка к живому прогону обязательна -
envelope_in_inflight (V2.4 major 6).

Пишет agents/<name>/done.json durable, под done.lock. Схема - §3 контракта,
включая поля, которые заполнит V2.7b (accepted_at/integrated_at/...) -
здесь они всегда null.

Фенсинг по workspace (spec.yaml):
  worktree: дерево обязано быть чистым (иначе exit 2, файл не создается);
            HEAD обязан быть на СВОЕЙ ветке task/<name>-* (не detached, не
            чужая) и быть потомком base. base = полный 40-hex sha,
            зафиксированный при create и лежащий в control.json; выводить
            его из самого HEAD нельзя - merge-base по определению предок
            HEAD, и проверка становится невыполнимой (аудит V2.7a). Ни
            одного коммита поверх base -> commit_sha == base, empty:true
            (не отказ) - именно так выглядит РАННИЙ вызов (V2.10 §3d.1):
            агент не коммитит сам (обертка claude-agent-commit упразднена),
            поэтому единственный момент, когда его собственное дерево
            заведомо чисто, - ДО того, как он начал редактировать файлы.
            Правильный протокол теперь - звать эту команду СРАЗУ, empty:
            true ожидаемо и не ошибка; терминальная ветка прогона
            (finalize_worktree_done, claude-agent-run, §3a) перечитывает
            HEAD ПОСЛЕ того, как рантайм сам закоммитит содержимое
            worktree, и подтягивает реальные commit_sha/branch/empty.
  direct:   changes:null - снимок "до" живет только в памяти раннера, и
            тот дописывает changes/empty в ЛЮБОЙ терминальной ветке
            прогона-владельца конверта (§3). Пока changes пусты, карточка
            не уходит - иначе улетела бы пустая.
  none:     только summary.

Идемпотентность: повтор при state=="requested" -> ok, файл не переписан
(кроме summary), КРОМЕ workspace:worktree с продвинувшимся commit_sha - там
это новая заявка (свежий рабочий результат), файл пересобирается заново.
Уже вынесенный вердикт (state вне null/requested) -> exit 2, файл не трогаем.

Отказ - exit 2 (та же дисциплина, что у claude-agent-ask).
"""

import fcntl
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _agent_question_io import envelope_in_inflight  # noqa: E402
from _agent_worktree import GitGuardError  # noqa: E402


def fail(msg, code=2):
    sys.stderr.write("claude-agent-done: %s\n" % msg)
    sys.exit(code)


from _agent_done_io import (request_done_locked, cap_summary, DoneError,
                            SpecReadError, DONE_SUMMARY_MAX_BYTES)


def main():
    summary = None
    args = sys.argv[1:]
    while args:
        a = args.pop(0)
        if a == "--summary" and args:
            summary = cap_summary(args.pop(0))
        else:
            fail("unknown/incomplete arg %r (usage: [--summary T])" % a)

    agent_dir = os.environ.get("CLAUDE_AGENT_DIR", "")
    envelope_key = os.environ.get("CLAUDE_AGENT_EVENT_KEY", "")
    if not agent_dir or not os.path.isdir(agent_dir):
        fail("CLAUDE_AGENT_DIR не задан или не существует")
    if not envelope_key:
        fail("CLAUDE_AGENT_EVENT_KEY не задан (runner должен прокидывать)")
    # привязка к живому прогону (V2.3/V2.4 major 6, общая с claude-agent-ask)
    if not envelope_in_inflight(agent_dir, envelope_key):
        fail("CLAUDE_AGENT_EVENT_KEY не соответствует конверту в inflight "
             "этого агента")

    lock_fd = os.open(os.path.join(agent_dir, "done.lock"), os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        request_done_locked(agent_dir, envelope_key, summary)
    except (DoneError, SpecReadError, GitGuardError) as exc:
        fail(str(exc))
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


if __name__ == "__main__":
    main()
