# Что установщик кладет в BIN_DIR - и что снимает деинсталлятор.
#
# Один список на оба скрипта. Раньше их было два: install.sh перечислял 29 имен,
# uninstall.sh знал пять, и после демонтажа на машине оставался весь агентный
# пояс с python-хелперами (поймано на Mac 2026-08-13, 24 сироты). Расхождение
# двух списков не видно ни в одном прогоне, поэтому список ровно один, а тест
# tests/test-install-completeness.sh следит, что оба скрипта читают его, а не
# свою копию.
#
# Формат: одно имя файла из bin/ в строке. Пустые строки и # - комментарии.

ai-rc
codex-rc
_codex_rc.py
# Общие helpers отдельного Codex TASK runtime.
_codex_task_lifecycle.py
_codex_task_transport.py
_codex_task_policy.py
_codex_task_profile.py
_codex_task_host.py
_codex_task_bridge.py
_codex_task_backend.py
_codex_task_files.py
_codex_task_store.py
ai-rc-agent
ai-rc-takeover
ai-control-logrotate

# Пояс агентов (Linux)
ai-agent-io
ai-agent-run
ai-agent-session
ai-agent-reconciler
ai-agent-checkrun
ai-agent-review
ai-agent-ask
ai-agent-answer
ai-agent-permit
ai-agent-done
ai-agent-harvest
ai-agent-tgbot
ai-agent-limits-digest
ai-agent-model-advice

# Синтез речи: зовет ai-agent-tgbot рядом с собой (BIN_DIR), но и сам
# запускается напрямую
voice-report
ai-agent-voice-hook
ai-control-transcript-gc
ai-agent-waiting-hook

# Помощники: их не запускают напрямую, их зовет соседний скрипт по $(dirname $0)
_rc_projects.sh
_control_provider_accounts.py
_control_provider_context.py
_control_provider_profile_cli.py
